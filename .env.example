# Firebase Web app settings (public client configuration; loaded by Vite at build time).
# These must all come from the same Firebase project. Never place service-account
# private keys or other server credentials in VITE_* variables.
# In Firebase Console, enable Authentication, then enable Email/Password and
# Google under Authentication > Sign-in method and set a support email. Configure
# verification/reset email templates. Add localhost for local testing and every
# deployed website host under Authentication > Settings > Authorized domains.
# For projects created after April 28, 2025, localhost may need to be added manually.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Backend Firebase ID-token validation. Must match VITE_FIREBASE_PROJECT_ID.
# The backend verifies Firebase tokens using Google's public signing keys; no
# service-account JSON/private key or Firebase Admin SDK credential is required.
FIREBASE_PROJECT_ID=""
# Optional backend alias for the Firebase Web API key used only by secure
# accounts:lookup photo fallback; if blank, the backend uses VITE_FIREBASE_API_KEY.
FIREBASE_WEB_API_KEY=""
# Optional comma-separated website origins accepted by authenticated account and
# visitor analytics requests in production.
AUTH_ALLOWED_ORIGINS=""

# Administrator credentials are provisioned into SQLite for an existing admin
# account with: npm run setup:admin-credentials -- --username <admin-id>
# Never put administrator passwords in source code or VITE_* variables.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# Optional API origin override for the website assistant, accounts, and visitor
# analytics. Leave blank to use localhost:4000 during Vite development and
# same-origin /api in production.
VITE_ASSISTANT_API_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

TELEGRAM_BOT_TOKEN=""

