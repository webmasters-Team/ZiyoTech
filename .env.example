# Firebase Web app settings (public client configuration; loaded by Vite at build time).
# These must all come from the same Firebase project. Never place service-account
# private keys or other server credentials in VITE_* variables.
# In Firebase Console, enable Authentication, then enable Email/Password and
# Google under Authentication > Sign-in method and set a support email. Configure
# verification/reset email templates. Add localhost for local testing and every
# deployed website host under Authentication > Settings > Authorized domains.
# For projects created after April 28, 2025, localhost may need to be added manually.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Backend Firebase ID-token validation. Must match VITE_FIREBASE_PROJECT_ID.
# The backend verifies Firebase tokens using Google's public signing keys; no
# service-account JSON/private key or Firebase Admin SDK credential is required.
FIREBASE_PROJECT_ID=""
# Optional backend alias for the Firebase Web API key used only by secure
# accounts:lookup photo fallback; if blank, the backend uses VITE_FIREBASE_API_KEY.
FIREBASE_WEB_API_KEY=""
# Optional comma-separated website origins accepted by authenticated account and
# visitor analytics requests in production. Set to https://ziyotech.net on Render.
AUTH_ALLOWED_ORIGINS=""

# Administrator credentials are provisioned in the configured database for an
# existing admin account with: npm run setup:admin-credentials -- --username <admin-id>
# Never put administrator passwords in source code or VITE_* variables.

# Server-side Gemini API key. Set this as a secret on the backend service.
GEMINI_API_KEY=""

# Optional API origin override for browser API requests. Production frontend
# builds use https://api.ziyotech.net; local development defaults to localhost:4000.
VITE_API_URL=""
VITE_ASSISTANT_API_BASE_URL=""
# Keep Project Management hidden until its PostgreSQL migration is separately approved/applied.
VITE_PROJECT_MANAGEMENT_ENABLED="false"

# Required backend-only PostgreSQL connection for all non-test runtime environments.
# Application startup fails without DATABASE_URL; there is no SQLite runtime fallback.
# Never expose these values as VITE_* variables. Keep local development values in
# the ignored .env.supabase.local file.
DATABASE_URL=""
# Optional Supabase project CA certificate path for strict TLS verification.
DATABASE_SSL_CA_FILE=""
# Application pool size, capped by the backend between 1 and 10.
DATABASE_POOL_MAX="5"

# APP_URL: Production frontend origin. Set to https://ziyotech.net on Render.
APP_URL=""

TELEGRAM_BOT_TOKEN=""


# Server-only HMAC pepper for client project access codes; use 32+ random bytes.
# Leave unset to keep client portal access unavailable. Never expose this as a VITE_ variable.
CLIENT_ACCESS_CODE_PEPPER=

# Enable Project Management APIs only after its PostgreSQL migration is installed.
PROJECT_MANAGEMENT_ENABLED="false"
