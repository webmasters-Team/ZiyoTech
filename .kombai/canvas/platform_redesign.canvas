scope bar\">\n<h1 data-kid=\"1-3-1-1\" data-name=\"page title heading\">Overview</h1>\n<div class=\"scope-btn\" data-kid=\"1-3-1-2\" data-name=\"scope filter dropdown\"><span data-kid=\"1-3-1-2-1\" data-name=\"scope descriptor text\">Scope</span><b data-kid=\"1-3-1-2-2\" data-name=\"scope filter value\">Available records</b><i class=\"icon-chevron-down\" data-kid=\"1-3-1-2-3\" data-name=\"chevron-down arrow icon\"></i></div>\n<div class=\"counters\" data-kid=\"1-3-1-3\" data-name=\"overview stats container\">\n<div class=\"counter\" data-kid=\"1-3-1-3-1\" data-name=\"conversations counter\"><b data-kid=\"1-3-1-3-1-1\" data-name=\"conversations count value\">4</b> conversations</div>\n<div class=\"counter\" data-kid=\"1-3-1-3-2\" data-name=\"AI conversations counter\"><b data-kid=\"1-3-1-3-2-1\" data-name=\"conversations number\">2</b> AI</div>\n<div class=\"counter\" data-kid=\"1-3-1-3-3\" data-name=\"human conversations counter\"><b data-kid=\"1-3-1-3-3-1\" data-name=\"automated conversations number\">1</b> human</div>\n<div class=\"counter\" data-kid=\"1-3-1-3-4\" data-name=\"resolved counter\"><b data-kid=\"1-3-1-3-4-1\" data-name=\"resolved conversations number\">1</b> resolved</div>\n<div class=\"counter\" data-kid=\"1-3-1-3-5\" data-name=\"pending order counter\"><b data-kid=\"1-3-1-3-5-1\" data-name=\"pending order number\">1</b> pending order</div>\n</div>\n<div class=\"sp\" data-kid=\"1-3-1-4\" data-name=\"flex spacer\"></div>\n<a class=\"btn\" data-kid=\"1-3-1-5\" data-name=\"open inbox action button\"><i class=\"icon-message-square\" data-kid=\"1-3-1-5-1\" data-name=\"messages icon\"></i>Open inbox</a>\n</div>\n<div class=\"work\" data-kid=\"1-3-2\" data-name=\"overview 3-column workspace\">\n<!-- conversation queue -->\n<section class=\"pane queue\" data-kid=\"1-3-2-1\" data-name=\"inbox conversation queue pane\">\n<div class=\"ph\" data-kid=\"1-3-2-1-1\" data-name=\"queue header bar\">\n<h2 data-kid=\"1-3-2-1-1-1\" data-name=\"queue title (Inbox)\">Inbo