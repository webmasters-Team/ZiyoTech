        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n@import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\");\n\n:root{\n  --paper:#F5F3EE;\n  --surface:#FFFFFF;\n  --chrome:#EDEAE3;\n  --raised:#FBFAF7;\n  --line:#DFDBD1;\n  --line-ink:#C8C3B6;\n  --ink:#191C20;\n  --ink-2:#4C5157;\n  --ink-3:#7B8086;\n  --accent:#1E4FD6;\n  --accent-ink:#173FA8;\n  --accent-wash:#E9EEFB;\n  --ok:#1B6B48;\n  --warn:#8C5400;\n  --warn-wash:#FAEEDB;\n  --stop:#A3341F;\n}\n.app,.app *{box-sizing:border-box}\nbody{margin:0;background:var(--paper);}\n.app{\n  display:flex;height:900px;\n  font-family:'Plus Jakarta Sans',system-ui,sans-serif;\n  font-size:13px;line-height:1.45;color:var(--ink);\n  background:var(--paper);-webkit-font-smoothing:antialiased;\n}\n.app i[class^=\"icon-\"]{font-size:16px;line-height:1;color:inherit;display:block}\n.app i.bi{font-size:15px;line-height:1;color:inherit;display:block}\n.mono{font-family:'JetBrains Mono',monospace;font-variant-numeric:tabular-nums}\n\n/* ---------- sidebar ---------- */\n.side{width:216px;flex:0 0 216px;background:var(--chrome);border-right:1px solid var(--line-ink);display:flex;flex-direction:column;height:100%}\n.side-brand{height:76px;flex:0 0 76px;display:flex;align-items:center;gap:10px;padding:0 14px;border-bottom:1px solid var(--line)}\n.mark{width:34px;height:34px;border-radius:6px;background:#16202E;display:flex;align-items:center;justify-content:center;flex:0 0 34px}\n.mark svg{width:22px;height:22px;display:block}\n.brand-name{font-size:14px;font-weight:700;letter-spacing:-.01em;line-height:1.2}\n.brand-name span{color:var(--accent)}\n.brand-sub{font-size:11px;color:var(--ink-2);line-height:1.5;margin-top:1px}\n.brand-handle{font-size:10px;color:var(--ink-3);font-family:'JetBrains Mono',monospace;line-height:1.5}\n\n.nav{flex:1;overflow-y:auto;padding:14px 10px 8px;display:flex;flex-direction:column;gap:14px}\n.nav-group{display:flex;flex-direction:column;gap:2px}\n.nav-label{font-size:10px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-3);padding:0 8px 6px}\n.nav-item{height:38px;display:flex;align-items:center;gap:9px;padding:0 9px;border-radius:5px;color:var(--ink-2);text-decoration:none;font-size:12.5px;font-weight:500;cursor:pointer;border:1px solid transparent}\n.nav-item:hover{background:#E4E0D7;color:var(--ink)}\n.nav-item.active{background:var(--surface);border-color:var(--line-ink);color:var(--ink);font-weight:600}\n.nav-item.active i{color:var(--accent)}\n.nav-item .sp{flex:1}\n.count{min-width:19px;height:18px;padding:0 5px;border-radius:3px;background:#DCD7CB;color:var(--ink-2);font-family:'JetBrains Mono',monospace;font-size:10.5px;font-weight:600;display:flex;align-items:center;justify-content:center;font-style:normal}\n.nav-item.active .count{background:var(--accent);color:#fff}\n.nav-item .soon{font-size:10px;color:var(--ink-3)}\n\n.side-foot{flex:0 0 auto;border-top:1px solid var(--line);padding:10px}\n.who{display:flex;align-items:center;gap:9px;padding:7px 8px;border-radius:5px;cursor:pointer}\n.who:hover{background:#E4E0D7}\n.who .ini{width:26px;height:26px;border-radius:50%;background:#D9D4C7;color:var(--ink-2);font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;letter-spacing:.02em;flex:0 0 26px}\n.who .nm{font-size:12px;font-weight:600;line-height:1.3}\n.who .rl{font-size:10.5px;color:var(--ink-3);line-height:1.3}\n.who .cv{margin-left:auto;color:var(--ink-3)}\n.who .cv i{font-size:14px}\n.side-links{display:flex;align-items:center;justify-content:space-between;padding:4px 8px 2px}\n.side-link{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--ink-2);cursor:pointer;padding:4px 0}\n.side-links i{font-size:14px}\n.side-links .side-links-right{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--ink-3)}\n\n/* ---------- main ---------- */\n.main{flex:1;min-width:0;display:flex;flex-direction:column;height:100%}\n.topbar{height:56px;flex:0 0 56px;background:var(--raised);border-bottom:1px solid var(--line-ink);display:flex;align-items:center;gap:14px;padding:0 20px}\n.crumb{font-size:13px;font-weight:600;letter-spacing:-.005em}\n.crumb span{color:var(--ink-3);font-weight:500;margin-left:6px}\n.conn{display:flex;align-items:center;gap:7px;height:28px;padding:0 10px;border:1px solid var(--line);border-radius:4px;background:var(--surface);font-size:11.5px;color:var(--ink-2)}\n.conn b{font-weight:600;color:var(--ink);font-family:'JetBrains Mono',monospace;font-size:11px}\n.dot{width:6px;height:6px;border-radius:50%;display:inline-block;flex:0 0 6px}\n.dot.ok{background:#1F8A5B}\n.dot.warn{background:#C98600}\n.dot.stop{background:#C0452B}\n.dot.idle{background:#A9AEB4}\n.topbar .sp{flex:1}\n.qaccess{display:flex;align-items:center;gap:8px;height:30px;padding:0 10px;border:1px solid var(--line-ink);border-radius:4px;background:var(--surface);font-size:12px;font-weight:600;cursor:pointer;color:var(--ink)}\n.qaccess i:last-child{font-size:14px;color:var(--ink-3)}\n.topbar-sep{width:1px;height:22px;background:var(--line-ink)}\n\n.content{flex:1;overflow-y:auto;padding:20px;background:var(--paper)}\n\n.page-head{height:48px;display:flex;align-items:center;gap:12px}\nh1{margin:0;font-size:20px;font-weight:700;letter-spacing:-.02em}\n.scope{display:flex;align-items:center;gap:8px;height:30px;padding:0 9px;border:1px solid var(--line-ink);border-radius:4px;background:var(--surface);font-size:12px;color:var(--ink-2);cursor:pointer}\n.scope b{font-weight:600;color:var(--ink)}\n.scope i{font-size:14px;color:var(--ink-3)}\n.page-head .sp{flex:1}\n.btn{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 12px;border-radius:4px;font-size:12.5px;font-weight:600;cursor:pointer;border:1px solid var(--line-ink);background:var(--surface);color:var(--ink);text-decoration:none}\n.btn i{font-size:15px}\n.btn:hover{border-color:var(--ink-3)}\n.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}\n.btn.primary:hover{background:var(--accent-ink);border-color:var(--accent-ink)}\n.btn.primary .count-mini{background:rgba(255,255,255,.22);color:#fff;font-family:'JetBrains Mono',monospace;font-size:10.5px;padding:1px 4px;border-radius:2px}\n\n/* summary strip */\n.summary{margin-top:12px;height:56px;display:grid;grid-template-columns:1.15fr 1.3fr 1fr 1fr 1fr;background:var(--surface);border:1px solid var(--line-ink);border-radius:4px}\n.sum{padding:0 14px;display:flex;flex-direction:column;justify-content:center;gap:1px;border-right:1px solid var(--line)}\n.sum:last-child{border-right:0}\n.sum .k{font-size:10.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.sum .v{font-family:'JetBrains Mono',monospace;font-size:18px;font-weight:600;letter-spacing:-.02em;line-height:1.15;font-variant-numeric:tabular-nums}\n.sum .v.txt{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:600;letter-spacing:0;display:flex;align-items:center;gap:6px}\n.sum .v .accent{color:var(--accent-ink)}\n\n/* queues */\n.queues{margin-top:16px;display:grid;grid-template-columns:minmax(0,1.28fr) minmax(0,1fr);gap:16px;align-items:start}\n.panel{background:var(--surface);border:1px solid var(--line-ink);border-radius:4px;overflow:hidden}\n.p-head{height:44px;display:flex;align-items:center;gap:10px;padding:0 12px;border-bottom:1px solid var(--line)}\n.p-head h2{margin:0;font-size:13px;font-weight:700;letter-spacing:-.005em;white-space:nowrap}\n.p-head .n{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-3);padding-top:1px}\n.p-head .sp{flex:1}\n.chips{display:flex;align-items:center;gap:2px;background:var(--paper);border:1px solid var(--line);border-radius:4px;padding:2px}\n.chip{height:23px;padding:0 8px;border:0;background:transparent;border-radius:3px;font-family:inherit;font-size:11.5px;font-weight:500;color:var(--ink-3);cursor:pointer;display:flex;align-items:center;gap:5px}\n.chip b{font-family:'JetBrains Mono',monospace;font-size:10.5px;font-weight:600}\n.chip.active{background:var(--surface);color:var(--ink);box-shadow:0 1px 2px rgba(25,28,32,.09);font-weight:600}\n.link{font-size:11.5px;font-weight:600;color:var(--accent-ink);text-decoration:none;display:inline-flex;align-items:center;gap:4px;cursor:pointer;white-space:nowrap}\n.link i{font-size:13px}\n\n.queue{display:flex;flex-direction:column}\n.crow{height:72px;display:flex;align-items:center;gap:11px;padding:0 12px;border-bottom:1px solid var(--line);cursor:pointer;background:var(--surface)}\n.crow:last-child{border-bottom:0}\n.crow:hover{background:var(--raised)}\n.av{width:32px;height:32px;border-radius:50%;object-fit:cover;flex:0 0 32px;background:#DDD8CC}\n.crow-main{flex:1;min-width:0}\n.crow-top{display:flex;align-items:baseline;gap:7px;min-width:0}\n.cname{font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.chandle{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ink-3);white-space:nowrap}\n.unread{min-width:16px;height:16px;padding:0 4px;border-radius:3px;background:var(--accent);color:#fff;font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:600;display:flex;align-items:center;justify-content:center;flex:0 0 auto}\n.cprev{font-size:12px;color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px;max-width:100%}\n.cright{flex:0 0 auto;display:flex;flex-direction:column;align-items:flex-end;gap:5px;padding-left:6px}\n.ctime{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ink-3);white-space:nowrap}\n.cstate{display:flex;align-items:center;gap:5px;font-size:10.5px;font-weight:600;color:var(--ink-2);white-space:nowrap}\n.clang{font-family:'JetBrains Mono',monospace;font-size:9.5px;color:var(--ink-3);border:1px solid var(--line);border-radius:2px;padding:0 3px;line-height:1.5;text-transform:uppercase}\n\n/* order queue */\n.orow{height:72px;display:flex;align-items:center;gap:10px;padding:0 12px;border-bottom:1px solid var(--line)}\n.orow:last-child{border-bottom:0}\n.orow:hover{background:var(--raised)}\n.o-left{flex:0 0 112px;display:flex;flex-direction:column;gap:3px}\n.ono{font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:600;letter-spacing:-.01em}\n.ostate{display:flex;align-items:center;gap:5px;font-size:9.5px;font-weight:600;color:var(--ink-2);white-space:nowrap;letter-spacing:.005em}\n.ostate.w{color:var(--warn)}\n.o-mid{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}\n.ocust{font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.oprod{font-size:11px;color:var(--ink-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.o-right{flex:0 0 88px;text-align:right;display:flex;flex-direction:column;gap:2px}\n.oamt{font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:600;white-space:nowrap}\n.odate{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--ink-3);white-space:nowrap}\n.o-open{flex:0 0 auto;height:26px;padding:0 8px;border:1px solid var(--line-ink);border-radius:4px;background:var(--surface);color:var(--ink);font-family:inherit;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap}\n.o-open:hover{background:var(--ink);color:#fff;border-color:var(--ink)}\n.orow.is-pending{background:#FDF9F1}\n.orow.is-pending:hover{background:#FBF4E7}\n\n/* maintenance */\n.maint{margin-top:16px;display:grid;grid-template-columns:minmax(0,1.28fr) minmax(0,1fr);gap:16px;align-items:start}\n.m-head{height:44px;display:flex;align-items:center;gap:10px;padding:0 12px;border-bottom:1px solid var(--line)}\n.m-head h2{margin:0;font-size:13px;font-weight:700}\n.p-head .threshold{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ink-2);border:1px solid var(--line);background:var(--raised);border-radius:3px;padding:2px 6px}\n.srow{height:44px;display:flex;align-items:center;gap:12px;padding:0 12px}\n.srow .sname{font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.srow .ssku{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ink-3);margin-left:auto;white-space:nowrap}\n.srow .sqty{font-family:'JetBrains Mono',monospace;font-size:11.5px;font-weight:600;color:var(--stop);white-space:nowrap}\n.srow .sqty.muted{color:var(--ink-2)}\n.hrow{height:38px;display:flex;align-items:center;gap:8px;padding:0 12px;border-bottom:1px solid var(--line);font-size:12px;cursor:pointer}\n.hrow:last-child{border-bottom:0}\n.hrow:hover{background:var(--raised)}\n.hrow .hk{color:var(--ink-2)}\n.hrow .hv{margin-left:auto;display:flex;align-items:center;gap:6px;font-size:11.5px;font-weight:600}\n.hrow .hv .mono{font-size:11px}\n.hrow .cv{color:var(--ink-3)}\n.hrow .cv i{font-size:13px}\n.hrow .icon-i{color:var(--ink-3)}\n.hrow .icon-i i{font-size:14px}\n\n/* tablet */\n@media (max-width:1180px){\n  .side{width:64px;flex:0 0 64px}\n  .side-brand{justify-content:center;padding:0;height:64px;flex:0 0 64px}\n  .brand-txt,.nav-label,.nav-item span,.nav-item .count,.who .nm,.who .rl,.who .cv,.side-links{display:none}\n  .nav{padding:12px 8px;gap:10px;align-items:center}\n  .nav-item{width:44px;justify-content:center;padding:0}\n  .nav-group{align-items:center}\n  .who{justify-content:center;padding:6px 0}\n  .topbar{padding:0 16px}\n  .content{padding:16px}\n  .queues,.maint{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}\n}\n@media (max-width:980px){\n  .queues,.maint{grid-template-columns:minmax(0,1fr)}\n  .summary{grid-template-columns:repeat(3,1fr);height:auto}\n  .sum{padding:10px 12px;border-bottom:1px solid var(--line)}\n  .sum:nth-child(3n){border-right:0}\n  .page-head{height:auto;flex-wrap:wrap;padding:4px 0 2px}\n}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"app layout root\">\n<aside class=\"side\" data-kid=\"1-1\" data-name=\"app sidebar navigation\">\n<div class=\"side-brand\" data-kid=\"1-1-1\" data-name=\"sidebar brand header\">\n<div class=\"mark\" data-kid=\"1-1-1-1\" data-name=\"brand logo mark container\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon\" fill=\"none\" viewbox=\"0 0 48 48\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M9 10H39V17.5L22 32.5H39V40H9V32.5L26 17.5H9V10Z\" fill=\"#F3F1EA\"></path>\n<circle cx=\"24\" cy=\"25\" fill=\"#2E63E8\" r=\"2.4\"></circle>\n</svg>\n</div>\n<div class=\"brand-txt\" data-kid=\"1-1-1-2\" data-name=\"brand text block\">\n<div class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">Ziyo<span data-kid=\"1-1-1-2-1-1\" data-name=\"brand name accent word\">Tech</span></div>\n<div class=\"brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"brand partner subtitle\">Retail Partner</div>\n<div class=\"brand-handle\" data-kid=\"1-1-1-2-3\" data-name=\"brand account handle\">@ziyotech_brand_demo</div>\n</div>\n</div>\n<nav class=\"nav\" data-kid=\"1-1-2\" data-name=\"primary navigation\">\n<div class=\"nav-group\" data-kid=\"1-1-2-1\" data-name=\"daily work navigation group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-1-1\" data-name=\"daily work section label\">Daily work</div>\n<div class=\"nav-item active\" data-kid=\"1-1-2-1-2\" data-name=\"overview navigation link (active)\"><i class=\"icon-house\" data-kid=\"1-1-2-1-2-1\" data-name=\"home icon\"></i><span data-kid=\"1-1-2-1-2-2\" data-name=\"overview nav label\">Overview</span></div>\n<div class=\"nav-item\" data-kid=\"1-1-2-1-3\" data-name=\"inbox navigation link\"><i class=\"icon-message-square\" data-kid=\"1-1-2-1-3-1\" data-name=\"message square icon\"></i><span data-kid=\"1-1-2-1-3-2\" data-name=\"inbox nav label\">Inbox</span><span class=\"sp\" data-kid=\"1-1-2-1-3-3\" data-name