    },
    "var_8d5a0d47f08c": {
      "type": "variant",
      "label": "V3 · Review register",
      "parentId": "var_27544df978b8",
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n@import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\");\n\n:root{\n  --paper:#F5F3EE;\n  --surface:#FFFFFF;\n  --panel:#FAF9F5;\n  --line:#E1DDD3;\n  --line-ink:#CBC6B9;\n  --ink:#191C20;\n  --ink-2:#4C5157;\n  --ink-3:#7C8187;\n  --accent:#1E4FD6;\n  --accent-ink:#173FA8;\n  --accent-wash:#EBEFFB;\n  --ok:#1B6B48;\n  --warn:#8C5400;\n  --warn-wash:#FAF0DC;\n  --stop:#A3341F;\n}\n.app,.app *{box-sizing:border-box}\nbody{margin:0;background:var(--paper)}\n.app{display:flex;height:900px;font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-size:13px;line-height:1.45;color:var(--ink);background:var(--paper);-webkit-font-smoothing:antialiased}\n.app i[class^=\"icon-\"]{font-size:16px;line-height:1;color:inherit;display:block}\n.app i.bi{font-size:14px;line-height:1;color:inherit;display:block}\n.mono{font-family:'JetBrains Mono',monospace;font-variant-numeric:tabular-nums}\n.dot{width:6px;height:6px;border-radius:50%;display:inline-block;flex:0 0 6px}\n.dot.ok{background:#1F8A5B}.dot.warn{background:#C98600}.dot.stop{background:#C0452B}.dot.idle{background:#A9AEB4}\n\n/* sidebar */\n.side{width:184px;flex:0 0 184px;background:var(--panel);border-right:1px solid var(--line-ink);display:flex;flex-direction:column;height:100%}\n.sb{height:82px;flex:0 0 82px;display:flex;align-items:center;gap:9px;padding:0 12px;border-bottom:1px solid var(--line)}\n.mark{width:30px;height:30px;border-radius:5px;background:#16202E;display:flex;align-items:center;justify-content:center;flex:0 0 30px}\n.mark svg{width:19px;height:19px;display:block}\n.bname{font-size:13px;font-weight:700;letter-spacing:-.01em;line-height:1.2}\n.bname span{color:var(--accent)}\n.bsub{font-size:10.5px;color:var(--ink-2);line-height:1.5;margin-top:1px}\n.bhd{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--ink-3);line-height:1.5}\n.nav{flex:1;overflow-y:auto;padding:12px 8px;display:flex;flex-direction:column;gap:14px}\n.ng{display:flex;flex-direction:column;gap:1px}\n.nl{font-size:9.5px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-3);padding:0 7px 5px}\n.ni{height:34px;display:flex;align-items:center;gap:8px;padding:0 7px;border-radius:3px;font-size:12px;font-weight:500;color:var(--ink-2);cursor:pointer;border:1px solid transparent;text-decoration:none}\n.ni:hover{background:#EDEAE2;color:var(--ink)}\n.ni.active{background:var(--surface);border-color:var(--line-ink);color:var(--ink);font-weight:600}\n.ni.active i{color:var(--accent)}\n.ni i{font-size:15px;flex:0 0 15px}\n.ni .sp{flex:1}\n.ni em{font-family:'JetBrains Mono',monospace;font-style:normal;font-size:10px;font-weight:600;color:var(--ink-3);min-width:14px;height:15px;display:flex;align-items:center;justify-content:center;border-radius:2px;background:#E6E2D8}\n.ni.active em{background:var(--accent);color:#fff}\n.sfoot{flex:0 0 auto;border-top:1px solid var(--line);padding:8px}\n.who{display:flex;align-items:center;gap:8px;padding:6px;border-radius:3px;cursor:pointer}\n.who:hover{background:#EDEAE2}\n.who .ini{width:24px;height:24px;border-radius:50%;background:#DED9CC;color:var(--ink-2);font-size:9.5px;font-weight:700;display:flex;align-items:center;justify-content:center;flex:0 0 24px}\n.who .t{font-size:11.5px;font-weight:600;line-height:1.3}\n.who .r{font-size:10px;color:var(--ink-3);line-height:1.3}\n.who i{margin-left:auto;font-size:12px;color:var(--ink-3)}\n.slink{display:flex;align-items:center;justify-content:space-between;padding:3px 6px 1px}\n.slink div{display:flex;align-items:center;gap:5px;font-size:10.5px;color:var(--ink-2);cursor:pointer}\n.slink i{font-size:13px}\n\n/* header */\n.main{flex:1;min-width:0;display:flex;flex-direction:column;height:100%}\n.hd{height:52px;flex:0 0 52px;display:flex;align-items:center;gap:10px;padding:0 16px;background:var(--surface);border-bottom:1px solid var(--line-ink)}\nh1{margin:0;font-size:17px;font-weight:700;letter-spacing:-.015em}\n.scope{display:flex;align-items:center;gap:6px;height:27px;padding:0 8px;border:1px solid var(--line-ink);border-radius:3px;background:var(--panel);font-size:11px;color:var(--ink-2);cursor:pointer}\n.scope b{font-weight:600;color:var(--ink)}\n.scope i{font-size:12px;color:var(--ink-3)}\n.hd .sp{flex:1}\n.attn{display:flex;align-items:center;gap:7px;height:28px;padding:0 9px;border:1px solid var(--line-ink);border-radius:3px;background:var(--surface);font-size:11.5px;font-weight:500;color:var(--ink);cursor:pointer}\n.attn i:first-child{font-size:14px;color:var(--warn)}\n.attn b{font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:600;min-width:16px;height:16px;border-radius:2px;background:var(--warn-wash);border:1px solid #E8D8B8;color:var(--warn);display:flex;align-items:center;justify-content:center}\n.attn i:last-child{font-size:12px;color:var(--ink-3)}\n.vsep{width:1px;height:20px;background:var(--line-ink)}\n.hd .who{padding:2px 4px}\n.hd .who:hover{background:var(--panel)}\n\n.content{flex:1;min-height:0;padding:16px;display:flex;flex-direction:column;gap:16px;overflow:hidden;background:var(--paper)}\n\n/* register */\n.register{flex:0 0 104px;height:104px;background:var(--surface);border:1px solid var(--line-ink);display:flex;flex-direction:column}\n.reg-row{display:flex;align-items:stretch}\n.reg-row.one{flex:0 0 55px;border-bottom:1px solid var(--line)}\n.reg-row.two{flex:0 0 48px;background:var(--panel)}\n.rc{display:flex;flex-direction:column;justify-content:center;gap:1px;padding:0 14px;border-right:1px solid var(--line);min-width:0}\n.rc:first-child{padding-left:16px}\n.rc.grow{flex:1}\n.rc .k{font-size:9.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3);white-space:nowrap}\n.rc .v{font-family:'JetBrains Mono',monospace;font-size:16px;font-weight:600;letter-spacing:-.02em;line-height:1.2;font-variant-numeric:tabular-nums}\n.rc .v.t{font-family:'Plus Jakarta Sans',sans-serif;font-size:12px;font-weight:600;letter-spacing:0;display:flex;align-items:center;gap:6px;white-space:nowrap}\n.rc .v.s{font-family:'Plus Jakarta Sans',sans-serif;font-size:11.5px;font-weight:600;letter-spacing:0;display:flex;align-items:center;gap:5px;white-space:nowrap;line-height:1.25}\n.rc.right{border-right:0;margin-left:auto;flex-direction:row;align-items:center;gap:12px;padding-right:16px}\n.link{font-size:11px;font-weight:600;color:var(--accent-ink);text-decoration:none;display:inline-flex;align-items:center;gap:4px;cursor:pointer;white-space:nowrap}\n.link i{font-size:12px}\n\n/* lower area */\n.lower{flex:0 0 auto;display:grid;grid-template-columns:minmax(0,1fr) 408px;gap:16px;align-items:start}\n.pane{background:var(--surface);border:1px solid var(--line-ink);display:flex;flex-direction:column;min-height:0;overflow:hidden}\n\n.tabs{flex:0 0 44px;display:flex;align-items:center;gap:0;padding:0 14px;border-bottom:1px solid var(--line);background:var(--surface)}\n.tb{height:44px;display:flex;align-items:center;gap:6px;padding:0 12px 0 0;margin-right:12px;font-size:12px;font-weight:500;color:var(--ink-3);cursor:pointer;border-bottom:2px solid transparent;white-space:nowrap;background:none;border-top:0;border-left:0;border-right:0;font-family:inherit}\n.tb b{font-family:'JetBrains Mono',monospace;font-size:10.5px;font-weight:600;color:var(--ink-3)}\n.tb.on{color:var(--ink);font-weight:700;border-bottom-color:var(--accent)}\n.tb.on b{color:var(--accent-ink)}\n.tabs .sp{flex:1}\n\n.conv{flex:0 0 auto;border-bottom:1px solid var(--line)}\n.crow{height:56px;display:flex;align-items:center;gap:10px;padding:0 14px;cursor:pointer;background:var(--surface)}\n.crow:hover{background:var(--panel)}\n.av{width:26px;height:26px;border-radius:50%;object-fit:cover;flex:0 0 26px;background:#