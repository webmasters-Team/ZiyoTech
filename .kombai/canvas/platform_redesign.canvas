.\n            </div>\n</div>\n<div class=\"msg left\" data-kid=\"1-3-2-2-2-5\" data-name=\"customer message (left)\">\n<div class=\"who-lbl\" data-kid=\"1-3-2-2-2-5-1\" data-name=\"message sender label\">Customer <span class=\"tm\" data-kid=\"1-3-2-2-2-5-1-1\" data-name=\"message timestamp\">14:13</span></div>\n<div class=\"bubble\" data-kid=\"1-3-2-2-2-5-2\" data-name=\"message bubble text\">Спасибо, жду звонка.</div>\n</div>\n</div>\n<div class=\"composer\" data-kid=\"1-3-2-2-3\" data-name=\"message composer area\">\n<div class=\"aswho\" data-kid=\"1-3-2-2-3-1\" data-name=\"composer identity info\">\n<span class=\"a\" data-kid=\"1-3-2-2-3-1-1\" data-name=\"composer identity label\">Replying as</span>\n<span class=\"b\" data-kid=\"1-3-2-2-3-1-2\" data-name=\"composer identity value\">Dilshod R.</span>\n</div>\n<div class=\"field\" data-kid=\"1-3-2-2-3-2\" data-name=\"message input field\">\n<i class=\"icon-pencil\" data-kid=\"1-3-2-2-3-2-1\" data-name=\"edit icon\"></i>\n<input aria-label=\"Reply\" data-kid=\"1-3-2-2-3-2-2\" data-name=\"reply text input\" placeholder=\"Write a reply in Russian\" type=\"text\"/>\n</div>\n<button class=\"send\" data-kid=\"1-3-2-2-3-3\" data-name=\"send message button\"><span data-kid=\"1-3-2-2-3-3-1\" data-name=\"send button label\">Send reply</span><i class=\"icon-send\" data-kid=\"1-3-2-2-3-3-2\" data-name=\"paper plane icon\"></i></button>\n</div>\n</section>\n<!-- orders -->\n<section class=\"pane orders\" data-kid=\"1-3-2-3\" data-name=\"orders pane\">\n<div class=\"ph\" data-kid=\"1-3-2-3-1\" data-name=\"orders header bar\">\n<h2 data-kid=\"1-3-2-3-1-1\" data-name=\"orders title (Orders)\">Orders</h2><span class=\"n\" data-kid=\"1-3-2-3-1-2\" data-name=\"orders count badge\">4</span>\n<div class=\"sp\" data-kid=\"1-3-2-3-1-3\" data-name=\"flex spacer\"></div>\n<span data-kid=\"1-3-2-3-1-4\" data-name=\"pending order count label\" style=\"font-size:10.5px;color:var(--ink-3)\">1 pending</span>\n</div>\n<div class=\"pending\" data-kid=\"1-3-2-3-2\" data-name=\"pending orders section\">\n<div class=\"pend-card\" data-kid=\"1-3-2-3-2-1\" data-name=\"pending order card\">\n<div class=\"pend-top\" data-kid=\"1-3-2-3-2-1-1\" data-name=\"order card header\">\n<span class=\"ono\" data-kid=\"1-3-2-3-2-1-1-1\" data-name=\"order ID (NX-855)\">NX-855</span>\n<span class=\"st\" data-kid=\"1-3-2-3-2-1-1-2\" data-name=\"order status indicator\"><span class=\"dot warn\" data-kid=\"1-3-2-3-2-1-1-2-1\" data-name=\"status dot (warn)\"></span>Pending</span>\n</div>\n<div class=\"pend-cust\" data-kid=\"1-3-2-3-2-1-2\" data-name=\"customer name\">Kamila Saidova</div>\n<div class=\"pend-meta\" data-kid=\"1-3-2-3-2-1-3\" data-name=\"customer contact info\">@kamila_s · +998 91 888 99 00</div>\n<div class=\"pend-prod\" data-kid=\"1-3-2-3-2-1-4\" data-name=\"ordered product name\">Simsiz Shovqinni So'ndiruvchi Quloqlik</div>\n<div class=\"pend-foot\" data-kid=\"1-3-2-3-2-1-5\" data-name=\"order card footer\">\n<div class=\"pend-amt\" data-kid=\"1-3-2-3-2-1-5-1\" data-name=\"order amount with currency\">640 000<span data-kid=\"1-3-2-3-2-1-5-1-1\" data-name=\"currency label (UZS)\">UZS</span></div>\n<div class=\"pend-actions\" data-kid=\"1-3-2-3-2-1-5-2\" data-name=\"order action buttons\">\n<button class=\"btn small\" data-kid=\"1-3-2-3-2-1-5-2-1\" data-name=\"review order button\">Review order</button>\n</div>\n</div>\n</div>\n</div>\n<div class=\"match-note\" data-kid=\"1-3-2-3-3\" data-name=\"connected customer order note\">\n<i class=\"icon-user-round\" data-kid=\"1-3-2-3-3-1\" data-name=\"user icon\" style=\"font-size:13px\"></i>\n<span data-kid=\"1-3-2-3-3-2\" data-name=\"connected customer note text\">Orders for <b data-kid=\"1-3-2-3-3-2-1\" data-name=\"connected customer handle\">@jasur_tech</b></span>\n<span data-kid=\"1-3-2-3-3-3\" data-name=\"connected order count value\" style=\"margin-left:auto\"><b data-kid=\"1-3-2-3-3-3-1\" data-name=\"count value (0)\">0</b></span>\n</div>\n<div class=\"recent\" data-kid=\"1-3-2-3-4\" data-name=\"recent orders section\">\n<div class=\"sec\" data-kid=\"1-3-2-3-4-1\" data-name=\"section header row\"><span class=\"sec-label\" data-kid=\"1-3-2-3-4-1-1\" data-name=\"section label (Recent orders)\">Recent orders</span><div class=\"sp\" data-kid=\"1-3-2-3-4-1-2\" data-name=\"flex spacer\"></div><span data-kid=\"1-3-2-3-4-1-3\" data-name=\"section item count value\" style=\"font-size:10.5px;color:var(--ink-3)\">3</span></div>\n<div class=\"rrow\" data-kid=\"1-3-2-3-4-2\" data-name=\"recent order row\">\n<div class=\"rl\" data-kid=\"1-3-2-3-4-2-1\" data-name=\"recent order detail column\">\n<span class=\"ono\" data-kid=\"1-3-2-3-4-2-1-1\" data-name=\"order ID (NX-858)\">NX-858</span>\n<span class=\"nm\" data-kid=\"1-3-2-3-4-2-1-2\" data-name=\"customer name\">Shaxzod Aliyev</span>\n</div>\n<div class=\"rr\" data-kid=\"1-3-2-3-4-2-2\" data-name=\"recent order status column\">\n<span class=\"am\" data-kid=\"1-3-2-3-4-2-2-1\" data-name=\"order amount\">890 000 UZS</span>\n<span class=\"stt\" data-kid=\"1-3-2-3-4-2-2-2\" data-name=\"order status indicator\"><span class=\"dot ok\" data-kid=\"1-3-2-3-4-2-2-2-1\" data-name=\"status dot (ok)\"></span>Confirmed</span>\n</div>\n</div>\n<div class=\"rrow\" data-kid=\"1-3-2-3-4-3\" data-name=\"recent order row\">\n<div class=\"rl\" data-kid=\"1-3-2-3-4-3-1\" data-name=\"recent order detail column\">\n<span class=\"ono\" data-kid=\"1-3-2-3-4-3-1-1\" data-name=\"order ID (NX-857)\">NX-857</span>\n<span class=\"nm\" data-kid=\"1-3-2-3-4-3-1-2\" data-name=\"customer name\">Nilufar Rahimova</span>\n</div>\n<div class=\"rr\" data-kid=\"1-3-2-3-4-3-2\" data-name=\"recent order status column\">\n<span class=\"am\" data-kid=\"1-3-2-3-4-3-2-1\" data-name=\"order amount\">499 000 UZS</span>\n<span class=\"stt\" data-kid=\"1-3-2-3-4-3-2-2\" data-name=\"order status indicator\"><span class=\"dot idle\" data-kid=\"1-3-2-3-4-3-2-2-1\" data-name=\"status dot (idle)\"></span>Delivered</span>\n</div>\n</div>\n<div class=\"rrow\" data-kid=\"1-3-2-3-4-4\" data-name=\"recent order row\">\n<div class=\"rl\" data-kid=\"1-3-2-3-4-4-1\" data-name=\"recent order detail column\">\n<span class=\"ono\" data-kid=\"1-3-2-3-4-4-1-1\" data-name=\"order ID (NX-856)\">NX-856</span>\n<span class=\"nm\" data-kid=\"1-3-2-3-4-4-1-2\" data-name=\"customer name\">Bobur Mansurov</span>\n</div>\n<div class=\"rr\" data-kid=\"1-3-2-3-4-4-2\" data-name=\"recent order status column\">\n<span class=\"am\" data-kid=\"1-3-2-3-4-4-2-1\" data-name=\"order amount\">1 250 000 UZS</span>\n<span class=\"stt\" data-kid=\"1-3-2-3-4-4-2-2\" data-name=\"order status indicator\"><span class=\"dot ok\" data-kid=\"1-3-2-3-4-4-2-2-1\" data-name=\"status dot (ok)\"></span>Confirmed</span>\n</div>\n</div>\n</div>\n<div class=\"pane-foot\" data-kid=\"1-3-2-3-5\" data-name=\"orders pane footer\">\n<span data-kid=\"1-3-2-3-5-1\" data-name=\"source info text\">Source: Instagram DM</span>\n<span data-kid=\"1-3-2-3-5-2\" data-name=\"open orders link\" style=\"font-weight:600;color:var(--accent-ink)\">Open orders</span>\n</div>\n</section>\n</div>\n<div class=\"maint\" data-kid=\"1-3-3\" data-name=\"maintenance panels row\">\n<section class=\"mpanel\" data-kid=\"1-3-3-1\" data-name=\"stock panel\">\n<div class=\"ml\" data-kid=\"1-3-3-1-1\" data-name=\"panel title group\">\n<i class=\"icon-package\" data-kid=\"1-3-3-1-1-1\" data-name=\"package icon\" style=\"font-size:15px;color:var(--ink-3)\"></i>\n<span class=\"mtitle\" data-kid=\"1-3-3-1-1-2\" data-name=\"panel title text (Stock)\">Stock</span>\n</div>\n<div class=\"msep\" data-kid=\"1-3-3-1-2\" data-name=\"separator line\"></div>\n<div class=\"mstat\" data-kid=\"1-3-3-1-3\" data-name=\"lowest stock item info\" style=\"flex:1\">\n<span class=\"l\" data-kid=\"1-3-3-1-3-1\" data-name=\"lowest stock label\">Lowest stock</span>\n<span class=\"mval\" data-kid=\"1-3-3-1-3-2\" data-name=\"lowest stock item name\">Skandinav Dizayn Kursisi (Nordic Oak)</span>\n<span class=\"msub\" data-kid=\"1-3-3-1-3-3\" data-name=\"lowest stock item SKU\">NX-CHAIR-12</span>\n</div>\n<span class=\"thr\" data-kid=\"1-3-3-1-4\" data-name=\"stock threshold condition chip\">Stock ≤ 5</span>\n<span data-kid=\"1-3-3-1-5\" data-name=\"stock quantity value (5)\" style=\"font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:600;color:var(--stop)\">5</span>\n<div class=\"sp\" data-kid=\"1-3-3-1-6\" data-name=\"flex spacer\"></div>\n<a class=\"btn small\" data-kid=\"1-3-3-1-7\" data-name=\"open products button\">Open products</a>\n</section>\n<section class=\"mpanel\" data-kid=\"1-3-3-2\" data-name=\"integration health panel\">\n<div class=\"mstat\" data-kid=\"1-3-3-2-1\" data-name=\"webhook status stat\">\n<span class=\"l\" data-kid=\"1-3-3-2-1-1\" data-name=\"webhook label\">Webhook</span>\n<span class=\"v\" data-kid=\"1-3-3-2-1-2\" data-name=\"webhook value (Active)\"><span class=\"dot ok\" data-kid=\"1-3-3-2-1-2-1\" data-name=\"status dot (ok)\"></span>Active</span>\n</div>\n<div class=\"msep\" data-kid=\"1-3-3-2-2\" data-name=\"separator line\"></div>\n<div class=\"mstat\" data-kid=\"1-3-3-2-3\" data-name=\"meta token stat\">\n<span class=\"l\" data-kid=\"1-3-3-2-3-1\" data-name=\"meta token label\">Meta token</span>\n<span class=\"v mono\" data-kid=\"1-3-3-2-3-2\" data-name=\"meta token value (54 days left)\">54 days left</span>\n</div>\n<div class=\"msep\" data-kid=\"1-3-3-2-4\" data-name=\"separator line\"></div>\n<div class=\"mstat\" data-kid=\"1-3-3-2-5\" data-name=\"Instagram status stat\">\n<span class=\"l\" data-kid=\"1-3-3-2-5-1\" data-name=\"Instagram label\">Instagram</span>\n<span class=\"v\" data-kid=\"1-3-3-2-5-2\" data-name=\"Instagram value (Connected)\"><i class=\"bi bi-instagram\" data-kid=\"1-3-3-2-5-2-1\" data-name=\"Instagram icon\" style=\"font-size:12px;color:#A2447A\"></i>Connected</span>\n</div>\n<div class=\"sp\" data-kid=\"1-3-3-2-6\" data-name=\"flex spacer\"></div>\n<a class=\"btn small\" data-kid=\"1-3-3-2-7\" data-name=\"agent settings button\">Agent settings</a>\n</section>\n</div>\n</div>\n</div>",
