    },
    "var_27544df978b8": {
      "type": "variant",
      "label": "V2 · Conversation-led workspace",
      "parentId": "var_6576d3fbbffa",
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n@import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\");\n\n:root{\n  --paper:#F4F2ED;\n  --surface:#FFFFFF;\n  --panel:#FBFAF7;\n  --line:#E0DCD2;\n  --line-ink:#CCC7BA;\n  --ink:#181B1F;\n  --ink-2:#4D5258;\n  --ink-3:#7D8288;\n  --accent:#1E4FD6;\n  --accent-ink:#173FA8;\n  --accent-wash:#E9EEFB;\n  --ok:#1B6B48;\n  --warn:#8C5400;\n  --warn-wash:#FBF1DF;\n  --stop:#A3341F;\n}\n.app,.app *{box-sizing:border-box}\nbody{margin:0;background:var(--paper)}\n.app{display:flex;flex-direction:column;height:900px;font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-size:13px;line-height:1.45;color:var(--ink);background:var(--paper);-webkit-font-smoothing:antialiased}\n.app i[class^=\"icon-\"]{font-size:16px;line-height:1;color:inherit;display:block}\n.app i.bi{font-size:15px;line-height:1;color:inherit;display:block}\n.mono{font-family:'JetBrains Mono',monospace;font-variant-numeric:tabular-nums}\n.dot{width:6px;height:6px;border-radius:50%;display:inline-block;flex:0 0 6px}\n.dot.ok{background:#1F8A5B}.dot.warn{background:#C98600}.dot.stop{background:#C0452B}.dot.idle{background:#A9AEB4}\n\n/* top bar */\n.topbar{height:56px;flex:0 0 56px;display:flex;align-items:center;gap:12px;padding:0 16px;background:var(--surface);border-bottom:1px solid var(--line-ink)}\n.mark{width:30px;height:30px;border-radius:5px;background:#16202E;display:flex;align-items:center;justify-content:center;flex:0 0 30px}\n.mark svg{width:19px;height:19px;display:block}\n.brand{display:flex;align-items:baseline;gap:7px;font-size:14px;font-weight:700;letter-spacing:-.01em}\n.brand span{color:var(--accent)}\n.vsep{width:1px;height:20px;background:var(--line-ink)}\n.store{display:flex;align-items:center;gap:7px;min-width:0}\n.store .nm{font-size:12.5px;font-weight:600;white-space:nowrap}\n.store .hd{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-3);white-space:nowrap}\n.topbar .sp{flex:1}\n.chip-btn{display:flex;align-items:center;gap:6px;height:28px;padding:0 9px;border:1px solid var(--line);border-radius:4px;background:var(--panel);font-size:11.5px;color:var(--ink-2);cursor:pointer;white-space:nowrap}\n.chip-btn b{font-weight:600;color:var(--ink)}\n.chip-btn i:last-child{font-size:13px;color:var(--ink-3)}\n.role{display:flex;align-items:center;gap:7px;cursor:pointer;padding:0 4px}\n.role .ini{width:26px;height:26px;border-radius:50%;background:#E4E0D6;color:var(--ink-2);font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center}\n.role .rl{font-size:11.5px;font-weight:600;line-height:1.25}\n.role .nm{font-size:10.5px;color:var(--ink-3);line-height:1.25}\n.role i{color:var(--ink-3);font-size:13px}\n\n/* nav strip */\n.navstrip{height:48px;flex:0 0 48px;display:flex;align-items:center;gap:2px;padding:0 16px;background:var(--surface);border-bottom:1px solid var(--line-ink)}\n.tab{height:31px;padding:0 12px;display:flex;align-items:center;gap:6px;font-size:12.5px;font-weight:500;color:var(--ink-2);border-radius:4px;cursor:pointer;text-decoration:none;white-space:nowrap}\n.tab:hover{background:var(--paper);color:var(--ink)}\n.tab.active{background:var(--ink);color:#fff;font-weight:600}\n.tab em{font-family:'JetBrains Mono',monospace;font-size:10px;font-style:normal;font-weight:600;min-width:16px;height:16px;padding:0 4px;display:flex;align-items:center;justify-content:center;border-radius:2px;background:#E2DDD2;color:var(--ink-2)}\n.tab.active em{background:rgba(255,255,255,.22);color:#fff}\n.navstrip .sp{flex:1}\n.menu{height:31px;padding:0 9px;display:flex;align-items:center;gap:5px;font-size:12.5px;font-weight:500;color:var(--ink-2);border-radius:4px;cursor:pointer}\n.menu:hover{background:var(--paper);color:var(--ink)}\n.menu i{font-size:13px;color:var(--ink-3)}\n\n/* body */\n.body{flex:1;min-height:0;display:flex;flex-direction:column;padding:16px;gap:12px;overflow:hidden}\n.scope{height:44px;flex:0 0 44px;display:flex;align-items:center;gap:12px}\nh1{margin:0;font-size:19px;font-weight:700;letter-spacing:-.02em}\n.scope-btn{display:flex;align-items:center;gap:7px;height:28px;padding:0 8px;border:1px solid var(--line-ink);border-radius:4px;background:var(--surface);font-size:11.5px;color:var(--ink-2);cursor:pointer}\n.scope-btn b{color:var(--ink);font-weight:600}\n.scope-btn i{font-size:13px;color:var(--ink-3)}\n.counters{display:flex;align-items:center;gap:0;margin-left:4px;height:28px;border-left:1px solid var(--line-ink);padding-left:12px}\n.counter{display:flex;align-items:baseline;gap:5px;padding-right:12px;font-size:11.5px;color:var(--ink-3)}\n.counter b{font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:600;color:var(--ink)}\n.scope .sp{flex:1}\n.btn{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 11px;border-radius:4px;border:1px solid var(--line-ink);background:var(--surface);color:var(--ink);font-family:inherit;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;text-decoration:none}\n.btn:hover{border-color:var(--ink-3)}\n.btn i{font-size:14px}\n.btn.accent{border-color:var(--accent);color:var(--accent-ink);background:var(--accent-wash)}\n.btn.solid{background:var(--accent);border-color:var(--accent);color:#fff}\n.btn.small{height:26px;font-size:11px;padding:0 8px}\n\n.work{height:600px;flex:0 0 600px;display:grid;grid-template-columns:272px minmax(0,1fr) 404px;gap:12px;min-height:0}\n.pane{background:var(--surface);border:1px solid var(--line-ink);border-radius:2px;display:flex;flex-direction:column;min-height:0;overflow:hidden}\n.pane.queue{background:var(--panel)}\n.ph{height:48px;flex:0 0 48px;display:flex;align-items:center;gap:8px;padding:0 12px;border-bottom:1px solid var(--line)}\n.ph h2{margin:0;font-size:12.5px;font-weight:700;letter-spacing:-.005em;white-space:nowrap}\n.ph .n{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ink-3)}\n.ph .sp{flex:1}\n.seg{display:flex;align-items:center;gap:1px;background:var(--paper);border:1px solid var(--line);border-radius:3px;padding:2px}\n.seg button{height:21px;padding:0 6px;border:0;background:transparent;border-radius:2px;font-family:inherit;font-size:10.5px;font-weight:500;color:var(--ink-3);cursor:pointer;display:flex;align-items:center;gap:4px}\n.seg button b{font-family:'JetBrains Mono',monospace;font-size:9.5px;font-weight:600}\n.seg button.on{background:var(--surface);color:var(--ink);font-weight:600;box-shadow:0 1px 1px rgba(24,27,31,.08)}\n\n.queue-list{flex:1;overflow:hidden;display:flex;flex-direction:column}\n.qrow{height:80px;padding:8px 12px;display:flex;flex-direction:column;gap:2px;border-bottom:1px solid var(--line);cursor:pointer;position:relative}\n.qrow:hover{background:#F5F2EA}\n.qrow.sel{background:var(--accent-wash)}\n.qrow-top{display:flex;align-items:center;gap:7px}\n.av{width:24px;height:24px;border-radius:50%;object-fit:cover;flex:0 0 24px;background:#DDD8CC}\n.qname{font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}\n.qrow.sel .qname{color:var(--accent-ink)}\n.qhandle{font-family:'JetBrains Mono',monospace;font-size:9.5px;color:var(--ink-3);white-space:nowrap;margin-left:auto}\n.qprev{font-size:11.5px;color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.4}\n.qfoot{display:flex;align-items:center;gap:6px;font-size:9.5px;color:var(--ink-3);font-family:'JetBrains Mono',monospace;margin-top:auto}\n.qfoot .st{display:flex;align-items:center;gap:4px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;color:var(--ink-2);font-size:9.5px}\n.qfoot .lg{border:1px solid var(--line);border-radius:2px;padding:0 3px;line-height:1.5;text-transform:uppercase}\n.qfoot .ur{margin-left:auto;background:var(--accent);color:#fff;border-radius:2px;padding:0 4px;font-weight:600;font-size:9.5px;line-height:1.6}\n.queue-foot{flex:0 0 auto;border-top:1px solid var(--line);padding:9px 12px;display:flex;align-items:center;justify-content:space-between}\n\n/* thread */\n.thread{background:var(--surface)}\n.th{height:64px;flex:0 0 64px;display:flex;align-items:center;gap:10px;padding:0 14px;border-bottom:1px solid var(--line)}\n.th .av{width:34px;height:34px;flex:0 0 34px}\n.thname{font-size:13px;font-weight:700;display:flex;align-items:center;gap:6px}\n.thsub{display:flex;align-items:center;gap:6px;font-size:10.5px;color:var(--ink-3);margin-top:1px}\n.thsub .h{font-family:'JetBrains Mono',monospace}\n.thsub .lg{border:1px solid var(--line);border-radius:2px;padding:0 3px;text-transform:uppercase;line-height:1.5}\n.thsub .st{display:flex;align-items:center;gap:4px;font-weight:600;color:var(--warn)}\n.th .sp{flex:1}\n.th-actions{display:flex;align-items:center;gap:6px}\n.msgs{flex:1;min-height:0;overflow:hidden;padding:14px 16px;display:flex;flex-direction:column;gap:12px;background:var(--surface)}\n.msg{display:flex;flex-direction:column;gap:4px;max-width:82%}\n.msg.right{align-self:flex-end;align-items:flex-end}\n.who-lbl{display:flex;align-items:center;gap:5px;font-size:9.5px;font-weight:600;letter-spacing:.02em;color:var(--ink-3);text-transform:uppercase}\n.who-lbl i{font-size:11px}\n.who-lbl .tm{font-family:'JetBrains Mono',monospace;font-weight:400;letter-spacing:0;text-transform:none;color:var(--ink-3)}\n.bubble{padding:9px 12px;border-radius:12px;font-size:12.5px;line-height:1.55;color:var(--ink)}\n.msg.left .bubble{background:#F3F1EB;border-top-left-radius:3px}\n.msg.right .bubble{background:var(--accent-wash);border-top-right-radius:3px;color:#182446}\n.msg.right .who-lbl{color:var(--accent-ink)}\n.pcard{display:flex;align-items:center;gap:8px;padding:6px;border-radius:4px;background:rgba(255,255,255,.65);border:1px solid #D5DEEE;margin-bottom:6px}\n.pcard img{width:32px;height:32px;border-radius:3px;object-fit:cover;background:#DDD8CC}\n.pcard .pnm{font-size:11px;font-weight:600;line-height:1.3}\n.pcard .ppr{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--accent-ink);font-weight:600}\n.composer{flex:0 0 80px;border-top:1px solid var(--line);padding:10px 14px;display:flex;align-items:center;gap:8px;background:var(--panel)}\n.composer .field{flex:1;display:flex;align-items:center;gap:8px;height:38px;border:1px solid var(--line-ink);border-radius:6px;padding:0 11px;background:var(--surface)}\n.composer .field i{color:var(--ink-3);font-size:14px}\n.composer .field input{flex:1;border:0;outline:0;background:transparent;font-family:inherit;font-size:12.5px;color:var(--ink)}\n.composer .field input::placeholder{color:var(--ink-3)}\n.aswho{display:flex;flex-direction:column;justify-content:center;padding-right:6px}\n.aswho .a{font-size:9.5px;color:var(--ink-3);text-transform:uppercase;letter-spacing:.05em;font-weight:600}\n.aswho .b{font-size:11.5px;font-weight:600}\n.send{height:38px;padding:0 13px;border-radius:6px;border:1px solid var(--accent);background:var(--accent);color:#fff;font-family:inherit;font-size:12.5px;font-weight:600;display:flex;align-items:center;gap:6px;cursor:pointer}\n.send i{font-size:14px}\n\n/* orders pane */\n.orders .sec{padding:10px 12px;display:flex;align-items:center;gap:8px}\n.sec-label{font-size:10.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-3)}\n.sec .sp{flex:1}\n.pending{padding:0 12px 12px}\n.pend-card{border:1px solid #E9D9B6;background:#FDF8EE;border-radius:3px;padding:11px}\n.pend-top{display:flex;align-items:center;gap:7px;margin-bottom:7px}\n.pend-top .ono{font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:600}\n.pend-top .st{margin-left:auto;display:flex;align-items:center;gap:5px;font-size:10px;font-weight:600;color:var(--warn)}\n.pend-cust{font-size:12.5px;font-weight:600}\n.pend-meta{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--ink-3);margin-top:1px}\n.pend-prod{font-size:11.5px;color:var(--ink-2);margin-top:7px;line-height:1.4}\n.pend-foot{display:flex;align-items:flex-end;justify-content:space-between;margin-top:9px;padding-top:9px;border-top:1px solid #EBDDBF}\n.pend-amt{font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:600;letter-spacing:-.01em}\n.pend-amt span{font-size:9.5px;color:var(--ink-3);margin-left:3px;letter-spacing:.02em}\n.pend-actions{display:flex;align-items:center;gap:6px}\n.match-note{padding:0 12px 12px;display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--ink-3)}\n.match-note b{font-family:'JetBrains Mono',monospace;color:var(--ink-2);font-weight:500}\n.recent{border-top:1px solid var(--line);margin-top:2px}\n.rrow{height:60px;display:flex;align-items:center;gap:9px;padding:0 12px;border-bottom:1px solid var(--line)}\n.rrow:hover{background:var(--panel)}\n.rrow .rl{flex:1;min-width:0;display:flex;flex-direction:column;gap:1px}\n.rrow .ono{font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:600}\n.rrow .nm{font-size:11.5px;color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.rrow .rr{text-align:right;display:flex;flex-direction:column;gap:2px}\n.rrow .am{font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:600;white-space:nowrap}\n.rrow .dt{font-family:'JetBrains Mono',monospace;font-size:9.5px;color:var(--ink-3);white-space:nowrap}\n.rrow .stt{display:flex;align-items:center;gap:4px;font-size:9.5px;font-weight:600;color:var(--ink-2);justify-content:flex-end}\n.pane-foot{margin-top:auto;border-top:1px solid var(--line);padding:10px 12px;display:flex;align-items:center;justify-content:space-between;font-size:10.5px;color:var(--ink-3);background:var(--panel)}\n\n/* maintenance */\n.maint{height:96px;flex:0 0 96px;display:grid;grid-template-columns:1fr 1fr;gap:12px}\n.mpanel{background:var(--surface);border:1px solid var(--line-ink);border-radius:2px;display:flex;align-items:center;gap:14px;padding:0 14px;min-width:0}\n.mpanel .ml{display:flex;align-items:center;gap:9px;min-width:0}\n.mpanel .mtitle{font-size:10.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-3);white-space:nowrap}\n.mpanel .mval{font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.mpanel .msub{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--ink-3);white-space:nowrap}\n.mpanel .msep{width:1px;height:34px;background:var(--line)}\n.mpanel .sp{flex:1}\n.mstat{display:flex;flex-direction:column;gap:2px;min-width:0}\n.mstat .l{font-size:9.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-3);font-weight:600;white-space:nowrap}\n.mstat .v{display:flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;white-space:nowrap}\n.mstat .v.mono{font-size:11px;font-weight:500}\n.thr{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--ink-2);border:1px solid var(--line);background:var(--panel);border-radius:2px;padding:1px 5px;white-space:nowrap}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"app layout root\">\n<header class=\"topbar\" data-kid=\"1-1\" data-name=\"top application bar\">\n<div class=\"mark\" data-kid=\"1-1-1\" data-name=\"brand logo box\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1\" data-name=\"brand logo mark icon\" fill=\"none\" viewbox=\"0 0 48 48\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M9 10H39V17.5L22 32.5H39V40H9V32.5L26 17.5H9V10Z\" fill=\"#F3F1EA\"></path>\n<circle cx=\"24\" cy=\"25\" fill=\"#2E63E8\" r=\"2.4\"></circle>\n</svg>\n</div>\n<div class=\"brand\" data-kid=\"1-1-2\" data-name=\"brand wordmark\">Ziyo<span data-kid=\"1-1-2-1\" data-name=\"brand highlight segment (Tech)\">Tech</span></div>\n<div class=\"vsep\" data-kid=\"1-1-3\" data-name=\"vertical separator\"></div>\n<div class=\"store\" data-kid=\"1-1-4\" data-name=\"store account display\">\n<span class=\"nm\" data-kid=\"1-1-4-1\" data-name=\"store account name\">Retail Partner</span>\n<span class=\"hd\" data-kid=\"1-1-4-2\" data-name=\"store handle in monospace\">@ziyotech_brand_demo</span>\n</div>\n<div class=\"sp\" data-kid=\"1-1-5\" data-name=\"flex spacer\"></div>\n<div class=\"chip-btn\" data-kid=\"1-1-6\" data-name=\"agent status chip\"><span class=\"dot ok\" data-kid=\"1-1-6-1\" data-name=\"status dot (ok)\"></span><span data-kid=\"1-1-6-2\" data-name=\"agent status label\">Agent</span><b data-kid=\"1-1-6-3\" data-name=\"agent enabled value\">Enabled</b></div>\n<div class=\"chip-btn\" data-kid=\"1-1-7\" data-name=\"Instagram connection chip\"><i class=\"bi bi-instagram\" data-kid=\"1-1-7-1\" data-name=\"Instagram icon\"></i><span data-kid=\"1-1-7-2\" data-name=\"channel label (Instagram)\">Instagram</span><b data-kid=\"1-1-7-3\" data-name=\"channel connected status\">Connected</b></div>\n<div class=\"chip-btn\" data-kid=\"1-1-8\" data-name=\"token countdown chip\"><i class=\"icon-clock\" data-kid=\"1-1-8-1\" data-name=\"clock icon\"></i><span data-kid=\"1-1-8-2\" data-name=\"token label\">Token</span><b data-kid=\"1-1-8-3\" data-name=\"token days remaining\">54 days</b></div>\n<div class=\"vsep\" data-kid=\"1-1-9\" data-name=\"vertical separator\"></div>\n<div class=\"role\" data-kid=\"1-1-10\" data-name=\"account ownership menu item\">\n<div class=\"ini\" data-kid=\"1-1-10-1\" data-name=\"user initials avatar\">DR</div>\n<div data-kid=\"1-1-10-2\" data-name=\"user full name and role display\">\n<div class=\"rl\" data-kid=\"1-1-10-2-1\" data-name=\"user display name\">Dilshod Rahimov</div>\n<div class=\"nm\" data-kid=\"1-1-10-2-2\" data-name=\"user role label\">Owner</div>\n</div>\n<i class=\"icon-chevron-down\" data-kid=\"1-1-10-3\" data-name=\"chevron-down arrow icon\"></i>\n</div>\n</header>\n<nav class=\"navstrip\" data-kid=\"1-2\" data-name=\"secondary navigation tab bar\">\n<a class=\"tab active\" data-kid=\"1-2-1\" data-name=\"overview tab link\">Overview</a>\n<a class=\"tab